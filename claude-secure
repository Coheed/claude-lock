#!/usr/bin/env bash
# claude-secure: starts Claude Code only after the GPG passphrase was entered.
# The secret (API key or OAuth token from `claude setup-token`) is stored
# encrypted on disk only and handed to the `claude` process through a file
# descriptor, so it never shows up in its environment.
set -euo pipefail

KEYFILE="${CLAUDE_SECURE_KEYFILE:-$HOME/.claude/secure/api-key.gpg}"
CREDENTIALS="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.credentials.json"

die() {
  echo "claude-secure: $*" >&2
  exit 1
}

usage() {
  cat <<EOF
Usage: claude-secure [claude arguments...]

Decrypts the stored secret (GPG passphrase) and then starts \`claude\`.
The secret is either an API key or a subscription OAuth token
(created with \`claude setup-token\`); the type is detected automatically.
All arguments are passed to \`claude\` unchanged.

Environment:
  CLAUDE_SECURE_KEYFILE  Path to the encrypted secret (default: $KEYFILE)
EOF
}

main() {
  # Dedicated flag so that `claude --help` is still passed through.
  if [ "${1:-}" = "--lock-help" ]; then
    usage
    exit 0
  fi

  # Check everything before asking for the passphrase.
  command -v gpg >/dev/null || die "gpg is missing (sudo apt install gnupg)."
  command -v claude >/dev/null || die "claude not found in PATH."
  [ -f "$KEYFILE" ] || die "encrypted secret not found: $KEYFILE (run setup-claude-lock.sh install first)."

  if [ -n "$(find "$KEYFILE" -perm /077)" ]; then
    echo "claude-secure: warning: $KEYFILE is accessible by others (mode $(stat -c %a "$KEYFILE"))." >&2
  fi

  if command -v jq >/dev/null && [ -f "$CREDENTIALS" ] &&
    jq -e 'has("claudeAiOauth")' "$CREDENTIALS" >/dev/null 2>&1; then
    echo "claude-secure: warning: a stored login exists in $CREDENTIALS;" >&2
    echo "  plain \`claude\` can still start without a passphrase (see: setup-claude-lock.sh lock-login)." >&2
  fi

  GPG_TTY="$(tty 2>/dev/null)" || die "no terminal available for the passphrase prompt."
  export GPG_TTY

  # --no-symkey-cache: ask for the passphrase on every start.
  local secret
  secret="$(gpg --quiet --no-symkey-cache --decrypt "$KEYFILE")" ||
    die "decryption failed (wrong passphrase?)."
  [ -n "$secret" ] || die "decrypted secret is empty."

  # Remove anything that would take precedence over (or conflict with) the secret.
  unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN CLAUDE_CODE_OAUTH_TOKEN \
    CLAUDE_CODE_OAUTH_TOKEN_FILE_DESCRIPTOR CLAUDE_CODE_API_KEY_FILE_DESCRIPTOR

  case "$secret" in
    sk-ant-oat*) export CLAUDE_CODE_OAUTH_TOKEN_FILE_DESCRIPTOR=3 ;;
    *) export CLAUDE_CODE_API_KEY_FILE_DESCRIPTOR=3 ;;
  esac

  # Unlike a here-string: no trailing newline, never a temp file on disk.
  exec claude "$@" 3< <(printf '%s' "$secret")
}

main "$@"
